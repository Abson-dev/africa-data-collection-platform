# Copy to .env and fill in. Never commit .env.

PORT=8080

# ODK Central, plus a dedicated web user with Project Manager role on the pilot projects only
CENTRAL_URL=https://central.example.org
CENTRAL_EMAIL=bridge@example.org
CENTRAL_PASSWORD=change-me

# Where partial (SMS) records go: the sms_partial form from forms/templates
SMS_PARTIAL_PROJECT_ID=1
SMS_PARTIAL_FORM_ID=sms_partial
SMS_PARTIAL_FORM_VERSION=2026110901

# Shared secret in the Africa's Talking callback URL:
#   https://bridge.example.org/sms/inbound?token=<value>
# Generate with:  openssl rand -hex 32
SMS_WEBHOOK_TOKEN=

MERGE_INTERVAL_MINUTES=10

# Development only: forms and device keys from a JSON file (format: seed.example.json)
BRIDGE_SEED_FILE=
